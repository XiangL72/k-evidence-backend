# Local comparison database only. Export these values into the backend process;
# Spring Boot does not automatically load this file or a copied .env file.
# Supply the password locally; never commit credentials.
COMPARISON_DB_USERNAME=kcomparison_app
COMPARISON_DB_PASSWORD=
COMPARISON_DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174
AI_ENABLED=false
